pipeline {
    agent any

    options {
        disableConcurrentBuilds()
        timeout(time: 90, unit: 'MINUTES')
        timestamps()
    }

    parameters {
        choice(
            name: 'BUILD_COMPONENTS',
            choices: ['auto', 'all', 'gateway', 'inference'],
            description: 'auto: build only images whose paths changed since the last successful build.'
        )
    }

    environment {
        HARBOR = 'harbor.local:30080'
        HARBOR_PROJECT = 'library'
        APP_IMAGE = 'llm-serving'
        LLAMA_IMAGE = 'llm-serving-llama'
        HARBOR_IP = '127.0.0.1'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                sh '''
                    set -eu
                    echo "Workspace: $(pwd)"
                    echo "Commit: $(git rev-parse --short HEAD)"
                    echo "Branch: $(git branch --show-current)"
                '''
            }
        }

        stage('Detect Changes') {
            steps {
                script {
                    def components
                    if (params.BUILD_COMPONENTS == 'all') {
                        components = ['gateway', 'inference']
                    } else if (params.BUILD_COMPONENTS in ['gateway', 'inference']) {
                        components = [params.BUILD_COMPONENTS]
                    } else {
                        // Compare against the last green build so changes from failed builds are not skipped.
                        components = sh(
                            returnStdout: true,
                            script: 'deploy/scripts/detect-changes.sh "${GIT_PREVIOUS_SUCCESSFUL_COMMIT:-}"'
                        ).trim().readLines()
                    }
                    env.BUILD_GATEWAY = components.contains('gateway').toString()
                    env.BUILD_INFERENCE = components.contains('inference').toString()
                    echo "Build gateway: ${env.BUILD_GATEWAY}; build inference: ${env.BUILD_INFERENCE}"
                }
            }
        }

        stage('Check Environment and Harbor') {
            steps {
                sh '''
                    set -eu
                    export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
                    command -v docker
                    docker version
                    command -v python3
                    python3 --version

                    HARBOR_URL="http://$HARBOR"
                    portal_status=$(curl --silent --show-error \
                        --connect-timeout 5 --max-time 10 \
                        --resolve "harbor.local:30080:$HARBOR_IP" \
                        -o /dev/null -w '%{http_code}' "$HARBOR_URL/")
                    test "$portal_status" = "200" || {
                        echo "Harbor Portal check failed: HTTP $portal_status"
                        exit 1
                    }

                    registry_status=$(curl --silent --show-error \
                        --connect-timeout 5 --max-time 10 \
                        --resolve "harbor.local:30080:$HARBOR_IP" \
                        -o /dev/null -w '%{http_code}' "$HARBOR_URL/v2/")
                    case "$registry_status" in
                        200|401) echo "Harbor Registry API OK: HTTP $registry_status" ;;
                        *) echo "Harbor Registry API failed: HTTP $registry_status"; exit 1 ;;
                    esac
                '''
            }
        }

        stage('Validate Files') {
            steps {
                sh '''
                    set -eu
                    test -f gateway/Dockerfile
                    test -f gateway/requirements.txt
                    test -f gateway/app/main.py
                    test -f gateway/tests/test_api.py
                    test -f inference/engines/llamacpp/Dockerfile
                    test -f deploy/charts/gateway/Chart.yaml
                    test -f deploy/charts/inference/Chart.yaml
                    test -f deploy/values/model.yaml

                    WEIGHTS=$(git ls-files '*.gguf' '*.safetensors' '*.bin' '*.pt' '*.pth')
                    if [ -n "$WEIGHTS" ]; then
                        echo "ERROR: model weights must not be committed to Git:"
                        echo "$WEIGHTS"
                        exit 1
                    fi
                    echo "Required files found; no model weights are tracked by Git."
                '''
            }
        }

        stage('Python Tests') {
            when { expression { env.BUILD_GATEWAY == 'true' } }
            options { timeout(time: 15, unit: 'MINUTES') }
            steps {
                dir('gateway') {
                    sh '''
                        set -eu
                        python3 -m venv .venv-ci
                        .venv-ci/bin/python -m pip install --upgrade pip
                        .venv-ci/bin/python -m pip install -r requirements-dev.txt
                        .venv-ci/bin/python -m compileall -q app
                        .venv-ci/bin/python -m pytest -q
                    '''
                }
            }
        }

        stage('Helm Validation') {
            steps {
                sh '''
                    set -eu
                    export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
                    # Charts are validated on every build: they are cheap and deployable on their own.
                    helm lint deploy/charts/gateway -f deploy/values/model.yaml
                    helm lint deploy/charts/inference -f deploy/values/model.yaml
                    helm template llm-serving deploy/charts/gateway -n llm-serving \
                        -f deploy/values/model.yaml >/tmp/llm-serving-rendered.yaml
                    helm template llm-serving-inference deploy/charts/inference -n llm-serving \
                        -f deploy/values/model.yaml >>/tmp/llm-serving-rendered.yaml
                    if grep -Eiq 'OLLAMA_BASE_URL|llm-serving-ollama|ollamaImage' /tmp/llm-serving-rendered.yaml; then
                        echo "ERROR: rendered Helm manifest contains legacy Ollama configuration"
                        grep -Ein 'OLLAMA_BASE_URL|llm-serving-ollama|ollamaImage' /tmp/llm-serving-rendered.yaml || true
                        exit 1
                    fi
                '''
            }
        }

        stage('Build Images') {
            parallel {
                stage('Build FastAPI') {
                    when { expression { env.BUILD_GATEWAY == 'true' } }
                    options { timeout(time: 20, unit: 'MINUTES') }
                    steps {
                        sh '''
                            set -eu
                            export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
                            IMAGE="$HARBOR/$HARBOR_PROJECT/$APP_IMAGE"
                            docker build --pull --progress=plain \
                                -t "$IMAGE:$BUILD_NUMBER" \
                                -t "$IMAGE:latest" \
                                -f gateway/Dockerfile gateway
                            docker image inspect "$IMAGE:$BUILD_NUMBER" >/dev/null
                        '''
                    }
                }
                stage('Build llama.cpp + Qwen') {
                    when { expression { env.BUILD_INFERENCE == 'true' } }
                    options { timeout(time: 45, unit: 'MINUTES') }
                    steps {
                        sh '''
                            set -eu
                            export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
                            IMAGE="$HARBOR/$HARBOR_PROJECT/$LLAMA_IMAGE"
                            docker build --pull --progress=plain \
                                -t "$IMAGE:$BUILD_NUMBER" \
                                -t "$IMAGE:latest" \
                                -f inference/engines/llamacpp/Dockerfile inference/engines/llamacpp
                            docker image inspect "$IMAGE:$BUILD_NUMBER" >/dev/null
                        '''
                    }
                }
            }
        }

        stage('Push to Harbor') {
            when { expression { env.BUILD_GATEWAY == 'true' || env.BUILD_INFERENCE == 'true' } }
            options { timeout(time: 20, unit: 'MINUTES') }
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'harbor-credentials',
                        usernameVariable: 'HARBOR_USER',
                        passwordVariable: 'HARBOR_PASSWORD'
                    )
                ]) {
                    sh '''
                        set -eu
                        set +x
                        export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
                        trap 'docker logout "$HARBOR" >/dev/null 2>&1 || true' EXIT
                        printf '%s' "$HARBOR_PASSWORD" |
                            docker login "$HARBOR" -u "$HARBOR_USER" --password-stdin

                        if [ "$BUILD_GATEWAY" = "true" ]; then
                            docker push "$HARBOR/$HARBOR_PROJECT/$APP_IMAGE:$BUILD_NUMBER"
                            docker push "$HARBOR/$HARBOR_PROJECT/$APP_IMAGE:latest"
                        fi
                        if [ "$BUILD_INFERENCE" = "true" ]; then
                            docker push "$HARBOR/$HARBOR_PROJECT/$LLAMA_IMAGE:$BUILD_NUMBER"
                            docker push "$HARBOR/$HARBOR_PROJECT/$LLAMA_IMAGE:latest"
                        fi
                    '''
                }
            }
        }
    }

    post {
        success {
            script {
                // CD takes one tag per component; an empty tag means that image was not rebuilt.
                def gatewayTag = env.BUILD_GATEWAY == 'true' ? env.BUILD_NUMBER : ''
                def inferenceTag = env.BUILD_INFERENCE == 'true' ? env.BUILD_NUMBER : ''
                writeFile file: 'ci-tags.env', text: "GATEWAY_TAG=${gatewayTag}\nINFERENCE_TAG=${inferenceTag}\n"
                archiveArtifacts artifacts: 'ci-tags.env'
                echo "CI succeeded. GATEWAY_TAG=${gatewayTag ?: '(unchanged)'}; INFERENCE_TAG=${inferenceTag ?: '(unchanged)'}"
            }
        }
        failure {
            echo 'CI failed. CD should not be run until this build is green.'
        }
        always {
            echo "CI result: ${currentBuild.currentResult}; build: ${env.BUILD_NUMBER}"
        }
    }
}
