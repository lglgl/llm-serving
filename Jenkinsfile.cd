pipeline {
    agent any

    options {
        disableConcurrentBuilds()
        timestamps()
        timeout(time: 20, unit: 'MINUTES')
    }

    parameters {
        string(
            name: 'IMAGE_TAG',
            defaultValue: 'latest',
            description: '镜像标签；可以使用 latest 或 CI 构建号'
        )
    }

    environment {
        HARBOR = 'harbor.local:30080'
        K8S_CONTEXT = 'docker-desktop'
        K8S_NAMESPACE = 'llm-serving'
        RELEASE_NAME = 'llm-serving'
        HARBOR_CREDENTIALS = 'harbor-credentials'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Check Environment') {
            steps {
                sh '''
                    set -eu

                    echo "=== Check required files ==="
                    test -f k8s/Chart.yaml
                    test -f k8s/values.yaml

                    echo "=== Check tools ==="
                    command -v kubectl
                    command -v helm
                    command -v curl
                    command -v python3

                    echo "=== Check image tag ==="
                    case "$IMAGE_TAG" in
                        ""|*[!a-zA-Z0-9_.-]*)
                            echo "ERROR: Invalid IMAGE_TAG: $IMAGE_TAG"
                            exit 1
                            ;;
                    esac

                    echo "=== Select Kubernetes context ==="
                    kubectl config use-context "$K8S_CONTEXT"
                    kubectl get nodes

                    echo "=== Check Harbor ==="
                    status=$(curl --silent --show-error \
                        --connect-timeout 5 --max-time 10 \
                        --resolve "$HARBOR:127.0.0.1" \
                        -o /dev/null -w '%{http_code}' \
                        "http://$HARBOR/")

                    test "$status" = "200"
                    echo "Harbor portal HTTP: $status"
                '''
            }
        }

        stage('Validate Helm Chart') {
            steps {
                sh '''
                    set -eu

                    echo "=== Helm lint ==="
                    helm lint ./k8s -f k8s/values.yaml

                    echo "=== Render manifests ==="
                    helm template "$RELEASE_NAME" ./k8s \
                        --namespace "$K8S_NAMESPACE" \
                        -f k8s/values.yaml \
                        --set-string image.tag="$IMAGE_TAG" \
                        --set-string llamaImage.tag="$IMAGE_TAG" \
                        > /tmp/llm-serving-rendered.yaml

                    echo "=== Validate rendered Service names ==="
                    python3 - <<'PY'
import re
import sys

path = "/tmp/llm-serving-rendered.yaml"
text = open(path, encoding="utf-8").read()
documents = re.split(r"(?m)^---\\s*$", text)
services = []

for document in documents:
    if not re.search(r"(?m)^kind:\\s*Service\\s*$", document):
        continue

    metadata = re.search(
        r"(?ms)^metadata:\\s*\\n(.*?)(?=^\\S|\\Z)",
        document
    )

    name_match = None
    if metadata:
        name_match = re.search(
            r"(?m)^  name:\\s*(.*?)\\s*$",
            metadata.group(1)
        )

    name = name_match.group(1).strip() if name_match else ""

    if not name or name in ('""', "''"):
        print("ERROR: Rendered Service has an empty metadata.name.")
        print(document[:1000])
        sys.exit(1)

    services.append(name)
    print("Service:", name)

if not services:
    print("ERROR: No Service resources found in rendered chart.")
    sys.exit(1)

print("Service name validation passed.")
PY
                '''
            }
        }

        stage('Deploy') {
            steps {
                timeout(time: 10, unit: 'MINUTES') {
                    withCredentials([
                        usernamePassword(
                            credentialsId: "${HARBOR_CREDENTIALS}",
                            usernameVariable: 'HARBOR_USERNAME',
                            passwordVariable: 'HARBOR_PASSWORD'
                        )
                    ]) {
                        sh '''
                            set -eu

                            kubectl config use-context "$K8S_CONTEXT"
                            kubectl create namespace "$K8S_NAMESPACE" \
                                --dry-run=client -o yaml | kubectl apply -f -

                            echo "=== Update Harbor pull secret ==="
                            kubectl create secret docker-registry harbor-pull-secret \
                                --namespace "$K8S_NAMESPACE" \
                                --docker-server="$HARBOR" \
                                --docker-username="$HARBOR_USERNAME" \
                                --docker-password="$HARBOR_PASSWORD" \
                                --dry-run=client -o yaml \
                                | kubectl apply -f -

                            echo "=== Deploy with Helm ==="
                            echo "Release: $RELEASE_NAME"
                            echo "Namespace: $K8S_NAMESPACE"
                            echo "Image tag: $IMAGE_TAG"

                            helm upgrade --install "$RELEASE_NAME" ./k8s \
                                --namespace "$K8S_NAMESPACE" \
                                --values k8s/values.yaml \
                                --set-string image.tag="$IMAGE_TAG" \
                                --set-string llamaImage.tag="$IMAGE_TAG" \
                                --wait \
                                --timeout 6m

                            echo "=== Wait for FastAPI ==="
                            kubectl -n "$K8S_NAMESPACE" rollout status \
                                deployment/llm-serving --timeout=240s

                            echo "=== Wait for llama.cpp ==="
                            kubectl -n "$K8S_NAMESPACE" rollout status \
                                deployment/llm-serving-llama --timeout=360s
                        '''
                    }
                }
            }
        }

        stage('Deployment Information') {
            steps {
                sh '''
                    set -eu

                    echo "=== Helm release ==="
                    helm status "$RELEASE_NAME" -n "$K8S_NAMESPACE"
                    helm history "$RELEASE_NAME" -n "$K8S_NAMESPACE"

                    echo "=== Deployment images ==="
                    kubectl -n "$K8S_NAMESPACE" get deployments \
                        llm-serving llm-serving-llama \
                        -o custom-columns='NAME:.metadata.name,READY:.status.readyReplicas,DESIRED:.spec.replicas,IMAGE:.spec.template.spec.containers[*].image'

                    echo "=== Pods ==="
                    kubectl -n "$K8S_NAMESPACE" get pods -o wide

                    echo "=== Runtime image IDs ==="
                    kubectl -n "$K8S_NAMESPACE" get pods \
                        -o custom-columns='POD:.metadata.name,IMAGE:.spec.containers[*].image,IMAGE_ID:.status.containerStatuses[*].imageID'
                '''
            }
        }
    }

    post {
        success {
            echo 'CD completed successfully.'
        }
        failure {
            echo 'CD failed. Check the first failed stage before retrying.'
        }
        always {
            sh '''
                rm -f /tmp/llm-serving-rendered.yaml
            '''
        }
    }
}